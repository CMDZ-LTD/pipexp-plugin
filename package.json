{
  "name": "pipexp-plugin",
  "version": "0.1.4",
  "private": true,
  "type": "module",
  "description": "The PipeXP plugin: reports coding-agent sessions to a PipeXP board.",
  "engines": {
    "node": ">=18"
  },
  "bin": {
    "pipexp": "./bin/pipexp.mjs"
